---
/**
 * Big Quote — §8.
 * Two-line italic quote. NO attribution. The previously-used
 * "Iwan · Farm lead" line was a Claude Design fabrication and is
 * deliberately gone (TODO-DESIGN-05). The quote stands alone.
 */
---

<section class="section big-quote" aria-label="Quote">
  <div class="container big-quote__inner">
    <span class="big-quote__mark" aria-hidden="true">"</span>
    <blockquote class="big-quote__quote">
      <p>Come as you are.</p>
      <p>The fire is lit, the tea is brewing.</p>
    </blockquote>
  </div>
</section>

<style>
  .big-quote {
    background: var(--bg-dark);
  }

  .big-quote__inner {
    display: grid;
    gap: var(--s-6);
    text-align: center;
    max-width: 880px;
    margin-inline: auto;
    padding-block: clamp(40px, 8vw, 96px);
  }

  .big-quote__mark {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
    font-size: clamp(80px, 10vw, 160px);
    line-height: 0.6;
    margin-bottom: var(--s-4);
    user-select: none;
  }

  .big-quote__quote {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    color: var(--fg-on-dark-1);
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: var(--lh-quote);
    letter-spacing: var(--ls-heading);
  }

  .big-quote__quote p {
    margin: 0;
  }
</style>
