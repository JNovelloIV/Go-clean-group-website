---
interface Props { onDark?: boolean }
const { onDark = false } = Astro.props;
---
<span class="brand-logo" aria-hidden="true">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D6B53" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    {!onDark && (
      <path d="M11 20A8 8 0 0 1 3 12c0-4.4 3.6-8 8-8 .7 0 1.4.1 2 .3-1.6 1-2.6 2.7-2.6 4.7 0 3 2.4 5.4 5.4 5.4 1 0 2-.3 2.8-.7-.4 3.6-3.5 6.3-7.6 6.3z" transform="rotate(110 12 12)" fill="#2D6B53" fill-opacity=".15"/>
    )}
    <path d="M5 19c4-6 9-10 15-12-3 8-8 12-15 12z" fill="#2D6B53"/>
    <path d="M5 19c3-3 7-7 12-9" stroke="#5FBF9F" stroke-width="1.2"/>
  </svg>
</span>
