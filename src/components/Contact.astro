<section class="section dark" id="contact">
  <div class="container">
    <div class="cta-grid">
      <div class="cta-side reveal">
        <span class="eyebrow on-dark" data-en="Get a price" data-id="Dapatkan harga">Get a price</span>
        <h2 style="margin-top:14px;">
          <span data-en="Tell us about your villa." data-id="Ceritakan tentang villa Anda.">Tell us about your villa.</span>
          {" "}
          <span class="italic" style="color:var(--mint);" data-en="Get a quick reply." data-id="Dapat balasan cepat.">Get a quick reply.</span>
        </h2>
        <p
          style="color:rgba(255,255,255,.78); margin-top:14px;"
          data-en="Send the form and we'll open WhatsApp with your details ready to go. Or message us directly — same fast reply either way."
          data-id="Kirim form dan kami akan buka WhatsApp dengan detail Anda siap dikirim. Atau chat langsung — sama-sama cepat."
        >
          Send the form and we'll open WhatsApp with your details ready to go. Or message us directly — same fast reply either way.
        </p>
        <ul>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span data-en="Open every day, 07.00–17.00" data-id="Buka setiap hari, 07.00–17.00">Open every day, 07.00–17.00</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>+62 878 6457 3925</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>goclean277@gmail.com</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Kuta, Lombok Tengah</span>
          </li>
        </ul>
      </div>

      <form class="cta-form reveal" id="bookForm" novalidate>
        <h3 data-en="Book on WhatsApp" data-id="Booking via WhatsApp">Book on WhatsApp</h3>
        <p class="small" data-en="Submitting opens WhatsApp with your message ready to send." data-id="Mengirim akan membuka WhatsApp dengan pesan siap dikirim.">Submitting opens WhatsApp with your message ready to send.</p>

        <div class="field-row">
          <div class="field">
            <label for="f-name" data-en="Your name" data-id="Nama">Your name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="f-area" data-en="Area / village" data-id="Area / desa">Area / village</label>
            <select id="f-area" name="area">
              <option value="Kuta Centre">Kuta Centre</option>
              <option value="Tanjung Aan">Tanjung Aan</option>
              <option value="Gerupuk">Gerupuk</option>
              <option value="Selong Belanak">Selong Belanak (+Rp 50k)</option>
              <option value="Other">Other near Kuta</option>
            </select>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-villa" data-en="Villa size" data-id="Ukuran villa">Villa size</label>
            <select id="f-villa" name="villa">
              <option value="1-bedroom">1-bedroom — Rp 200k</option>
              <option value="2-bedroom">2-bedroom — Rp 250k</option>
              <option value="3-bedroom">3-bedroom — Rp 350k</option>
              <option value="Premium">Premium / 4+ bedrooms — Rp 600k</option>
            </select>
          </div>
          <div class="field">
            <label for="f-service" data-en="Service" data-id="Layanan">Service</label>
            <select id="f-service" name="service">
              <option data-en="Regular cleaning" data-id="Cleaning rutin" value="Regular cleaning">Regular cleaning</option>
              <option data-en="Deep cleaning" data-id="Deep cleaning" value="Deep cleaning">Deep cleaning</option>
              <option data-en="Exterior glass" data-id="Kaca luar" value="Exterior glass">Exterior glass</option>
              <option data-en="Garden care" data-id="Perawatan taman" value="Garden care">Garden care</option>
              <option data-en="Pre-opening deep clean (new villa)" data-id="Bersih total pra-buka (villa baru)" value="Pre-opening deep clean">Pre-opening deep clean</option>
              <option data-en="Weekly recurring (-15%)" data-id="Mingguan (-15%)" value="Weekly recurring">Weekly recurring (-15%)</option>
            </select>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-date" data-en="Preferred date" data-id="Tanggal yang diinginkan">Preferred date</label>
            <input id="f-date" name="date" type="date" />
          </div>
          <div class="field">
            <label for="f-time" data-en="Preferred time" data-id="Jam yang diinginkan">Preferred time</label>
            <select id="f-time" name="time">
              <option value="Morning (07–10)">Morning · 07–10</option>
              <option value="Midday (10–13)">Midday · 10–13</option>
              <option value="Afternoon (13–15)">Afternoon · 13–15</option>
              <option value="Flexible">Flexible</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="f-notes" data-en="Anything else?" data-id="Catatan tambahan?">Anything else?</label>
          <textarea id="f-notes" name="notes"></textarea>
        </div>

        <button class="btn btn-on-dark" type="submit" style="width:100%; justify-content:center; padding: 14px 22px;">
          <span class="live-dot" style="background:#1aaf52;" aria-hidden="true"></span>
          <span data-en="Open WhatsApp with my details" data-id="Buka WhatsApp dengan detail saya">Open WhatsApp with my details</span>
        </button>
        <p
          class="form-foot"
          data-en="No data is stored. We only use your message to reply on WhatsApp."
          data-id="Tidak ada data yang disimpan. Kami hanya pakai pesan Anda untuk balas di WhatsApp."
        >
          No data is stored. We only use your message to reply on WhatsApp.
        </p>
      </form>
    </div>
  </div>
</section>
