---
/**
 * Footer — §10.
 * Wordmark, tagline, links, meta line. Letters link is intentionally
 * absent — user's decision to hide the section entirely for v1.
 */
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__row">
      <a class="footer__brand" href="#top" aria-label="The Hill — home">
        <img
          class="footer__mark-img"
          src="/images/mark-gold-no-roots.png"
          alt=""
          width="1200"
          height="718"
        />
        <span class="footer__wordmark">
          <span class="footer__wordmark-the">The</span>&nbsp;<span class="footer__wordmark-hill">Hill</span>
        </span>
      </a>

      <p class="footer__tagline">
        A place being built, with intention.<br/>
        Darek · Central Lombok · Since mid-2024
      </p>

      <div class="footer__links">
        <a href="https://instagram.com/thehill_lombok" rel="me noopener" target="_blank">Instagram</a>
      </div>
    </div>

    <div class="footer__meta">
      <span>© The Hill</span>
      <span>Opening in small pieces. The list hears first.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--forest-deep);
    border-top: 1px solid var(--gold-20);
    padding: 100px var(--frame-inset) 40px;
    margin-top: 80px;
  }

  .footer__inner {
    max-width: var(--frame-max-w);
    margin-inline: auto;
  }

  /* Three-column row: brand | tagline | links — center-aligned baseline. */
  .footer__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 64px;
    align-items: center;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--gold-20);
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .footer__mark-img {
    width: 44px;
    height: auto;
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.005em;
  }

  .footer__wordmark-the {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }

  .footer__wordmark-hill {
    font-weight: 400;
    color: var(--fg-on-dark-1);
  }

  /* Center column — italic gold colophon, both lines. */
  .footer__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 20px;
    line-height: 1.4;
    color: var(--accent);
    text-align: center;
  }

  /* Right column — pipe-separated contact links. */
  .footer__links {
    display: flex;
    gap: 16px;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .footer__links a {
    color: var(--dark-body);
    transition: color 0.2s ease;
  }

  .footer__links a:hover,
  .footer__links a:focus-visible {
    color: var(--accent);
  }

  .footer__sep {
    color: var(--gold-35);
  }

  /* Bottom row — ALL CAPS, sage, letter-spaced. */
  .footer__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-6);
    padding-top: 28px;
  }

  .footer__meta span {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
  }

  @media (max-width: 900px) {
    .footer__row {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
      justify-items: center;
    }
    .footer__links {
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer__meta {
      flex-direction: column;
      gap: var(--s-3);
      text-align: center;
    }
  }
</style>
