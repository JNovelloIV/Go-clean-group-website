        <ul>
          <li><a href="#pricing" data-en="Pricing" data-id="Harga">Pricing</a></li>
          <li><a href="#how" data-en="How it works" data-id="Cara kerja">How it works</a></li>
          <li><a href="#area" data-en="Service area" data-id="Area layanan">Service area</a></li>
