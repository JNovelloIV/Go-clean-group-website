---
const images = [
  { src: '/images/no01_flock-mid-morning.jpg',      caption: 'The flock, mid-morning',     alt: 'The duck flock walking at the pond in the mid-morning light' },
  { src: '/images/no02_hands-and-earth.jpg',        caption: 'Hands & earth',              alt: 'A pair of hands working dark soil on the hill' },
  { src: '/images/no03_from-above.jpg',             caption: 'From above, on a still day', alt: 'An overhead view of the land and pond on a still day' },
  { src: '/images/no04_frame-going-up.jpg',         caption: 'The frame going up',         alt: 'The wooden structural frame of a building under construction on the hill' },
  { src: '/images/no05_path-six-months-in.jpg',     caption: 'The path, six months in',    alt: 'A worn path through the grass and plantings, six months after it was first cut' },
  { src: '/images/no06_among-the-grass.jpg',        caption: 'Among the grass',            alt: 'A close view of tall grass growing on the hill' },
];
---

<section id="gallery" class="section gallery" aria-labelledby="gallery-headline">
  <div class="container gallery__inner">
    <header class="gallery__hd">
      <h2 id="gallery-headline" class="gallery__headline">
        Some <em>honest</em><br/>moments from<br/>the hill.
      </h2>

      <p class="gallery__caption">
        Everything you see will change by next season. That's the point.
      </p>
    </header>

    <ul class="gallery__grid" role="list">
      {images.map((img, i) => (
        <li class={`gallery__item gallery__item--${i + 1}`}>
          <figure class="gallery__figure">
            <img
              class="gallery__img"
              src={img.src}
              alt={img.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="gallery__caption-line">{img.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery {
    background: var(--bg-dark);
  }

  .gallery__inner {
    display: grid;
    gap: 80px;
  }

  /* Header — h2 left, tagline right (editorial counterpoint), aligned to baseline. */
  .gallery__hd {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 48px;
  }

  .gallery__headline {
    font-family: var(--font-display);
    font-size: clamp(48px, 5vw, 80px);
    font-weight: 400;
    color: var(--fg-on-dark-1);
    line-height: 1.05;
    letter-spacing: -0.01em;
    max-width: 16ch;
    margin: 0;
  }

  .gallery__headline em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }

  .gallery__caption {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
    font-size: 22px;
    max-width: 280px;
    text-align: right;
    margin: 0;
  }

  .gallery__grid {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: var(--s-4);
  }

  /* Editorial irregular layout for a 6-up gallery */
  .gallery__item--1 { grid-column: span 4; grid-row: span 2; }
  .gallery__item--2 { grid-column: span 2; }
  .gallery__item--3 { grid-column: span 2; }
  .gallery__item--4 { grid-column: span 2; }
  .gallery__item--5 { grid-column: span 2; }
  .gallery__item--6 { grid-column: span 2; }

  .gallery__figure {
    margin: 0;
    display: grid;
    gap: var(--s-3);
    height: 100%;
    grid-template-rows: 1fr auto;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    min-height: 220px;
    border-radius: var(--r-md);
    background: var(--forest-tint);
    object-fit: cover;
  }

  /* Photo captions — italic gold, design's editorial overlay register. */
  .gallery__caption-line {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 18px;
    color: var(--accent);
    letter-spacing: 0;
    margin: 0;
  }

  @media (max-width: 820px) {
    .gallery__hd {
      flex-direction: column;
      align-items: flex-start;
    }
    .gallery__caption {
      text-align: left;
    }
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery__item--1,
    .gallery__item--2,
    .gallery__item--3,
    .gallery__item--4,
    .gallery__item--5,
    .gallery__item--6 {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
