---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

/**
 * Gallery — §6 "Some honest moments from the hill".
 * Six images with captions verbatim from the copy doc. Real photography
 * is not yet supplied; each image renders as a labeled placeholder UNTIL
 * a file is dropped at the expected path under /public/images/gallery/.
 *
 * The user can replace any placeholder by saving a real image at the
 * expected path — the build picks it up automatically (existsSync check
 * runs at build time). Alt text is preserved on the real <img> when a
 * file lands.
 *
 * Image 6 ("Rain, day four") is flagged in TODO-DESIGN-03 as possibly
 * a styled-only tile with no alt text. We treat it as decorative
 * (alt="" + aria-hidden) — the rest get real alt text from the copy doc.
 */

const images = [
  { src: '/images/gallery/01-flock-mid-morning.jpg', caption: 'The flock, mid-morning',     alt: 'The duck flock walking at the pond' },
  { src: '/images/gallery/02-hands-and-earth.jpg',   caption: 'Hands & earth',              alt: 'Hand-mixing compost in the bamboo shed' },
  { src: '/images/gallery/03-from-above.jpg',        caption: 'From above, on a still day', alt: 'Aerial of the pond and thatched shelter' },
  { src: '/images/gallery/04-morning-pause.jpg',     caption: 'A morning pause',            alt: 'A person watching ducks at the pond, banana palms behind' },
  { src: '/images/gallery/05-shade.jpg',             caption: 'Shade, always welcome',      alt: 'Ducks resting under a bamboo shelter' },
  { src: '/images/gallery/06-rain-day-four.jpg',     caption: 'Rain, day four',             alt: '', decorative: true },
];

// Resolve /public/images/gallery/<file>.jpg on disk; if it's there,
// render a real <img>. Otherwise render the styled placeholder.
const publicDir = fileURLToPath(new URL('../../public', import.meta.url));
const isAvailable = (src: string) => existsSync(`${publicDir}${src}`);
---

<section id="gallery" class="section gallery" aria-labelledby="gallery-headline">
  <div class="container gallery__inner">
    <h2 id="gallery-headline" class="gallery__headline">
      Some <em>honest</em><br/>moments from<br/>the hill.
    </h2>

    <p class="gallery__caption">
      Everything you see will change by next season. That's the point.
    </p>

    <ul class="gallery__grid" role="list">
      {images.map((img, i) => {
        const num = String(i + 1).padStart(2, '0');
        const available = isAvailable(img.src);
        return (
          <li class={`gallery__item gallery__item--${i + 1}`}>
            <figure class="gallery__figure">
              {available ? (
                <img
                  class="gallery__img"
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div
                  class="gallery__placeholder"
                  role={img.decorative ? 'presentation' : 'img'}
                  aria-hidden={img.decorative ? 'true' : undefined}
                  aria-label={img.decorative ? undefined : img.alt}
                  data-expected-src={img.src}
                >
                  <span class="gallery__placeholder-mark">No.&nbsp;{num}</span>
                </div>
              )}
              <figcaption class="gallery__caption-line">{img.caption}</figcaption>
            </figure>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .gallery {
    background: var(--bg-dark);
  }

  .gallery__inner {
    display: grid;
    gap: var(--s-10);
  }

  .gallery__headline {
    font-size: clamp(40px, 6vw, 84px);
    font-weight: 300;
    color: var(--fg-on-dark-1);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: 14ch;
  }

  .gallery__caption {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    color: var(--dark-body);
    font-size: clamp(18px, 1.6vw, 24px);
    max-width: 48ch;
  }

  .gallery__grid {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: var(--s-4);
  }

  /* Editorial irregular layout for a 6-up gallery */
  .gallery__item--1 { grid-column: span 4; grid-row: span 2; }
  .gallery__item--2 { grid-column: span 2; }
  .gallery__item--3 { grid-column: span 2; }
  .gallery__item--4 { grid-column: span 2; }
  .gallery__item--5 { grid-column: span 2; }
  .gallery__item--6 { grid-column: span 2; }

  .gallery__figure {
    margin: 0;
    display: grid;
    gap: var(--s-3);
    height: 100%;
    grid-template-rows: 1fr auto;
  }

  .gallery__img,
  .gallery__placeholder {
    width: 100%;
    height: 100%;
    min-height: 220px;
    border-radius: var(--r-md);
    background: var(--forest-tint);
  }

  .gallery__img {
    object-fit: cover;
  }

  .gallery__placeholder {
    display: grid;
    place-items: center;
    color: var(--dark-caption);
    border: 1px dashed var(--gold-28);
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 18px,
        rgba(200,160,80,0.05) 18px 19px
      );
    text-align: center;
    padding: var(--s-6);
  }

  .gallery__placeholder-mark {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(28px, 3vw, 42px);
    color: var(--gold-35);
  }

  .gallery__caption-line {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-caption);
    color: var(--dark-caption);
  }

  @media (max-width: 820px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery__item--1,
    .gallery__item--2,
    .gallery__item--3,
    .gallery__item--4,
    .gallery__item--5,
    .gallery__item--6 {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
