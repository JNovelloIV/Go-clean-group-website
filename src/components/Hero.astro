---
const WA_BOOK = "https://wa.me/6287864573925?text=Halo%20GoClean%2C%20saya%20ingin%20booking%20cleaning.";
---
<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="reveal in">
        <span class="eyebrow" data-en="Villa cleaning · Kuta, Lombok" data-id="Cleaning villa · Kuta, Lombok">Villa cleaning · Kuta, Lombok</span>
        <h1 style="margin-top:14px;">
          <span class="pause" data-en="Live fresh." data-id="Hidup segar.">Live fresh.</span>
          <span class="pause accent" data-en="Feel clean." data-id="Rasa bersih.">Feel clean.</span>
        </h1>
        <p
          class="hero-sub"
          data-en="A small local team that cleans villas in Kuta and around. Fair, published prices. Easy to book on WhatsApp. We bring our own tools and supplies — you just relax."
          data-id="Tim lokal kecil yang membersihkan villa di Kuta dan sekitarnya. Harga jelas dan terbuka. Mudah booking lewat WhatsApp. Kami bawa alat dan perlengkapan sendiri — Anda tinggal santai."
        >
          A small local team that cleans villas in Kuta and around. Fair, published prices. Easy to book on WhatsApp. We bring our own tools and supplies — you just relax.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={WA_BOOK} target="_blank" rel="noopener">
            <span class="live-dot" aria-hidden="true"></span>
            <span data-en="Message us on WhatsApp" data-id="Chat WhatsApp">Message us on WhatsApp</span>
          </a>
          <a class="btn btn-ghost" href="#pricing">
            <span data-en="See pricing" data-id="Lihat harga">See pricing</span>
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </a>
        </div>
      </div>

      <div class="hero-card reveal in">
        <div class="hero-card-top">
          <span data-en="Field notes — Kuta, Lombok" data-id="Catatan lapangan — Kuta, Lombok">Field notes — Kuta, Lombok</span>
          <span class="dot-row" aria-hidden="true"><span></span><span></span><span></span></span>
        </div>
        <div class="hero-card-mid">
          <span class="quote-mark" aria-hidden="true">&ldquo;</span>
          <p
            class="quote"
            data-en={`Same three faces every time. They bring everything, work quietly, and the villa just feels new again.`}
            data-id={`Tiga orang yang sama setiap kali. Mereka bawa semua, kerja tenang, dan villa terasa seperti baru lagi.`}
          >
            Same three faces every time. They bring everything, work quietly, and the villa just feels new again.
          </p>
        </div>
        <div class="hero-card-bot">
          <div>
            <span class="stat-num"><em>Fast</em></span>
            <span class="stat-lbl" data-en="WhatsApp replies during work hours" data-id="Balas WhatsApp di jam kerja">WhatsApp replies during work hours</span>
          </div>
          <div class="right">
            <span class="stat-num">3</span>
            <span class="stat-lbl" data-en="Kuta natives on the team" data-id="Asli Kuta di tim">Kuta natives on the team</span>
          </div>
        </div>
        <span class="badge">
          <span class="live-dot" aria-hidden="true"></span>
          <span data-en="Replying on WhatsApp now" data-id="Sedang membalas WhatsApp">Replying on WhatsApp now</span>
        </span>
      </div>
    </div>

    <div class="trust reveal-stagger">
      <div class="trust-item">
        <span class="trust-ico">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        <div>
          <strong data-en="6+ Google reviews" data-id="6+ ulasan Google">6+ Google reviews</strong>
          <span data-en="Real customers, recent jobs" data-id="Pelanggan asli, pekerjaan terkini">Real customers, recent jobs</span>
        </div>
      </div>
      <div class="trust-item">
        <span class="trust-ico">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <div>
          <strong data-en="3 Kuta natives" data-id="3 asli Kuta">3 Kuta natives</strong>
          <span data-en="Born here, in tourism since before Kuta was on the map" data-id="Lahir di sini, di industri turis sejak Kuta belum terkenal">Born here, in tourism since before Kuta was on the map</span>
        </div>
      </div>
      <div class="trust-item">
        <span class="trust-ico">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </span>
        <div>
          <strong data-en="Locally owned in Kuta" data-id="Milik lokal di Kuta">Locally owned in Kuta</strong>
          <span data-en="Serving Kuta, Tanjung Aan, Gerupuk" data-id="Melayani Kuta, Tanjung Aan, Gerupuk">Serving Kuta, Tanjung Aan, Gerupuk</span>
        </div>
      </div>
    </div>
  </div>
</section>
