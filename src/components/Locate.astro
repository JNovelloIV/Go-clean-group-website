---
/**
 * Locate — §3 "Where we are".
 * Map is a clearly-labeled placeholder. The full island-orientation map
 * is TODO-DESIGN-01 in the copy doc — Mataram, Lombok Airport (LOP),
 * Kuta, Selong Belanak, Lembar Harbor, Bangsal Harbor as secondary pins,
 * The Hill in gold as the primary. We render a stylized stand-in here
 * so the section's two-column layout is correct without faking the map.
 *
 * Body color uses --dark-body (#A8C090) which clears WCAG AA on the
 * Deep Forest background — fixes the contrast bug the previous Claude
 * Design build had on this section.
 *
 * VERIFY BEFORE LAUNCH: the body paragraph references "foothills of
 * Pergasingan" — Pergasingan is in east Lombok (Sembalun), not Central.
 * Possible Claude Design fabrication. User to confirm correct local
 * mountain reference. Marker in copy left as-is for now.
 */
---

<section id="locate" class="section locate" aria-labelledby="locate-headline">
  <div class="container locate__inner">
    <div class="locate__map map-viz" aria-hidden="true">
      <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Map of Lombok showing The Hill in Darek">
        <defs>
          <pattern id="locate-dots" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="0.8" fill="rgba(199,159,87,0.16)"/>
          </pattern>
          <radialGradient id="locate-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="#E6C477" stop-opacity="1"/>
            <stop offset="20%"  stop-color="#C79F57" stop-opacity="0.85"/>
            <stop offset="55%"  stop-color="#C79F57" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#C79F57" stop-opacity="0"/>
          </radialGradient>
          <path id="locate-lombok" d="
            M 112 115
            C 118 92, 138 78, 168 72
            C 200 66, 240 70, 275 82
            C 308 94, 335 112, 342 138
            C 346 160, 338 178, 322 192
            C 312 202, 314 220, 320 238
            C 326 258, 328 278, 316 298
            C 300 320, 270 336, 240 344
            C 212 350, 184 346, 160 336
            C 138 328, 122 314, 114 296
            C 108 280, 110 262, 106 244
            C 100 224, 92 208, 90 190
            C 90 172, 96 156, 102 140
            C 104 130, 106 122, 112 115 Z"/>
        </defs>

        <!-- Dotted ocean texture -->
        <rect width="400" height="400" fill="url(#locate-dots)"/>

        <!-- Ripple rings (Lombok outline scaled outward from The Hill at 177.8, 275.5) -->
        <g fill="none" stroke="#C79F57" stroke-linejoin="round">
          <g transform="translate(177.8 275.5) scale(1.12) translate(-177.8 -275.5)">
            <use href="#locate-lombok" stroke-opacity="0.40" stroke-width="0.9"/>
          </g>
          <g transform="translate(177.8 275.5) scale(1.24) translate(-177.8 -275.5)">
            <use href="#locate-lombok" stroke-opacity="0.25" stroke-width="0.8"/>
          </g>
          <g transform="translate(177.8 275.5) scale(1.38) translate(-177.8 -275.5)">
            <use href="#locate-lombok" stroke-opacity="0.15" stroke-width="0.7"/>
          </g>
          <g transform="translate(177.8 275.5) scale(1.54) translate(-177.8 -275.5)">
            <use href="#locate-lombok" stroke-opacity="0.08" stroke-width="0.7"/>
          </g>
        </g>

        <!-- Outer glow on The Hill -->
        <circle cx="177.8" cy="275.5" r="68" fill="url(#locate-glow)" opacity="0.55"/>

        <!-- Lombok island -->
        <use href="#locate-lombok" fill="rgba(46,74,38,0.40)" stroke="#C79F57" stroke-width="2.4" stroke-linejoin="round"/>

        <!-- Tight glow over the island, marking the pin -->
        <circle cx="177.8" cy="275.5" r="34" fill="url(#locate-glow)" opacity="0.75" style="mix-blend-mode: screen;"/>

        <!-- Compass -->
        <g transform="translate(345,60)" fill="rgba(199,159,87,0.85)">
          <circle cx="0" cy="0" r="14" fill="none" stroke="rgba(199,159,87,0.5)" stroke-width="0.5"/>
          <path d="M 0 -10 L 2 0 L 0 2 L -2 0 Z"/>
          <text x="0" y="-16" text-anchor="middle" font-family="DM Sans" font-size="8" letter-spacing="2">N</text>
        </g>

        <!-- Secondary pins (sage) on coastline -->
        <g fill="#6B7F5E">
          <circle cx="141.2" cy="205.2" r="3"/>
          <circle cx="200.2" cy="278.6" r="3"/>
          <circle cx="225.0" cy="348.0" r="3"/>
          <circle cx="157.3" cy="326.2" r="3"/>
          <circle cx="125.0" cy="265.3" r="3"/>
          <circle cx="175.0" cy="69.0" r="3"/>
        </g>

        <!-- The Hill pin -->
        <circle cx="177.8" cy="275.5" r="6" fill="#F2D896"/>
        <circle cx="177.8" cy="275.5" r="6" fill="none" stroke="rgba(199,159,87,0.55)" stroke-width="8"/>
        <circle cx="177.8" cy="275.5" r="3" fill="#FFF3D0"/>
      </svg>

      <!-- HTML labels positioned over SVG -->
      <div class="map-label primary centered" style="left: 44.45%; top: 63%;">The Hill</div>
      <div class="map-label secondary"             style="left: 50%;    top: 69.6%;">Airport <span class="muted">LOP</span></div>
      <div class="map-label secondary align-right" style="left: 35%;    top: 51.3%;">Mataram</div>
      <div class="map-label secondary align-right" style="left: 31%;    top: 66.3%;">Lembar</div>
      <div class="map-label secondary align-right" style="left: 39%;    top: 81.5%;">Selong Belanak</div>
      <div class="map-label secondary"             style="left: 55.5%;  top: 85.75%;">Kuta</div>
      <div class="map-label secondary"             style="left: 43.75%; top: 14.5%;">Bangsal</div>
    </div>

    <div class="locate__text">
      <p class="eyebrow">Where we are</p>

      <h2 id="locate-headline" class="locate__headline">
        A hill. Rice in every direction. <em>A lake, mountains beyond.</em>
      </h2>

      <div class="locate__body">
        <p>
          Darek is a village forty minutes inland from Kuta, past the surf towns and up into the foothills of Pergasingan. The land here is volcanic loam — black, clay-heavy, generous once you work with it.
        </p>
        <p>
          You won't find us on a beach bar map. We think that's a feature.
        </p>
      </div>

      <dl class="locate__meta" aria-label="Distances from The Hill">
        <div class="locate__meta-item">
          <dt>Airport</dt>
          <dd>10 km</dd>
        </div>
        <div class="locate__meta-item">
          <dt>Kuta</dt>
          <dd>25 km</dd>
        </div>
        <div class="locate__meta-item">
          <dt>Selong Belanak</dt>
          <dd>20 km</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .locate {
    background: var(--bg-dark);
  }

  .locate__inner {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(0, 1.2fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .locate__map {
    position: relative;
    aspect-ratio: 1;
  }

  .locate__map svg {
    width: 100%;
    height: 100%;
  }

  /* Map labels — positioned absolutely over the SVG, ALL CAPS letter-spaced. */
  .map-label {
    position: absolute;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(12px, -50%);
    pointer-events: none;
  }

  .map-label.secondary { color: var(--sage); }
  .map-label.secondary .muted {
    font-weight: 400;
    letter-spacing: 0.16em;
    color: rgba(107, 127, 94, 0.7);
  }

  .map-label.primary {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 0.24em;
  }

  .map-label.align-right {
    transform: translate(calc(-100% - 12px), -50%);
    text-align: right;
  }
  .map-label.centered {
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .locate__text {
    display: grid;
    gap: var(--s-8);
  }

  .locate__headline {
    font-size: clamp(32px, 4.4vw, 56px);
    color: var(--fg-on-dark-1);
    max-width: 18ch;
  }

  .locate__body {
    display: grid;
    gap: var(--s-5);
    color: var(--dark-body);
    font-size: var(--fs-body-sm);
    max-width: 58ch;
  }

  .locate__body p {
    line-height: var(--lh-body);
  }

  .locate__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
    padding-top: var(--s-6);
    border-top: var(--border-hairline-dark);
    margin: 0;
  }

  .locate__meta-item {
    display: grid;
    gap: var(--s-1);
  }

  .locate__meta dt {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--dark-eyebrow);
    font-weight: 500;
  }

  .locate__meta dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 1.8vw, 28px);
    color: var(--fg-on-dark-1);
  }

  @media (max-width: 900px) {
    .locate__inner {
      grid-template-columns: 1fr;
    }
    .locate__map {
      order: -1;
      max-width: 380px;
      margin-inline: auto;
    }
  }
</style>
