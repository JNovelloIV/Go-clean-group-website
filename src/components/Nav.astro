---
/**
 * Nav — top site navigation.
 * Items per copy doc §Global: Why · The Farm · Building · The Land
 * Letters is intentionally omitted for v1 (user decision: hide entirely
 * until the first real letter is written).
 * CTA: "Follow the Hill" anchors to #subscribe.
 *
 * Mobile (<= 720px) collapses the link list into a drawer behind a
 * hamburger toggle. Drawer items are the same set; CTA stays visible
 * in the top bar at all viewports.
 */

const items = [
  { href: '#manifesto', label: 'Why' },
  { href: '#production', label: 'The Farm' },
  { href: '#building',   label: 'Building' },
  { href: '#locate',     label: 'The Land' },
  { href: '#latest',     label: 'Letters' },
];
---

<nav class="nav" aria-label="Primary">
  <div class="nav__inner">
    <a class="nav__mark" href="#top" aria-label="The Hill — home">
      <img
        class="nav__mark-img"
        src="/images/horizontal-dark-transparent.png"
        alt="The Hill"
        width="3000"
        height="1020"
        decoding="sync"
        fetchpriority="high"
      />
    </a>

    <ul class="nav__links" role="list">
      {items.map((item) => (
        <li><a class="nav__link" href={item.href}>{item.label}</a></li>
      ))}
    </ul>

    <div class="nav__right">
      <a class="nav__cta" href="#subscribe">Follow the Hill</a>
      <button
        class="nav__burger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-drawer"
        data-nav-burger
      >
        <span class="nav__burger-line"></span>
        <span class="nav__burger-line"></span>
        <span class="nav__burger-line"></span>
      </button>
    </div>
  </div>
</nav>

<!--
  Drawer must be a SIBLING of <nav>, not a child. The nav has
  backdrop-filter, which (per CSS spec) creates an implicit
  containing block for any position:fixed descendants — that
  would scope the drawer to the nav's bounds instead of the
  viewport, and the drawer's full-screen overlay would collapse
  to a tiny strip behind the nav. Hoisting the drawer out
  fixes that.
-->
<div class="nav__drawer" id="nav-drawer" data-nav-drawer hidden>
  <ul class="nav__drawer-list" role="list">
    {items.map((item) => (
      <li><a class="nav__drawer-link" href={item.href} data-nav-drawer-link>{item.label}</a></li>
    ))}
  </ul>
</div>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-nav-burger]');
  const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-drawer-link]');

  if (burger && drawer) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      burger.classList.toggle('is-open', open);
      drawer.toggleAttribute('hidden', !open);
      drawer.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    links.forEach((a) => a.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--deep-forest) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: var(--border-hairline-dark);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    max-width: var(--frame-max-w);
    margin-inline: auto;
    padding: var(--s-4) var(--frame-inset);
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .nav__mark-img {
    height: 36px;
    width: auto;
    display: block;
  }

  @media (max-width: 720px) {
    .nav__mark-img {
      height: 30px;
    }
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--s-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dark-body);
    transition: color 0.2s ease;
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--accent);
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .nav__cta {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    padding: var(--s-3) var(--s-5);
    border-radius: var(--r-md);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .nav__cta:hover,
  .nav__cta:focus-visible {
    background: var(--accent);
    color: var(--deep-forest);
  }

  /* Hamburger -------------------------------------------------------- */
  .nav__burger {
    display: none;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 0;
    padding: 10px 8px;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
  }

  .nav__burger-line {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--fg-on-dark-2);
    transition: transform 0.25s ease, opacity 0.2s ease, background-color 0.2s ease;
    transform-origin: center;
  }

  .nav__burger.is-open .nav__burger-line:nth-child(1) {
    transform: translateY(8.25px) rotate(45deg);
    background: var(--accent);
  }

  .nav__burger.is-open .nav__burger-line:nth-child(2) {
    opacity: 0;
  }

  .nav__burger.is-open .nav__burger-line:nth-child(3) {
    transform: translateY(-8.25px) rotate(-45deg);
    background: var(--accent);
  }

  /* Drawer ----------------------------------------------------------- */
  .nav__drawer {
    display: none;
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--deep-forest);
    padding: var(--s-12) var(--frame-inset);
    z-index: 39;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .nav__drawer.is-open {
    opacity: 1;
  }

  .nav__drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-6);
  }

  .nav__drawer-link {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dark-body);
  }

  .nav__drawer-link:hover,
  .nav__drawer-link:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .nav__links {
      display: none;
    }
    .nav__burger {
      display: flex;
    }
    .nav__drawer {
      display: block;
    }
  }
</style>
