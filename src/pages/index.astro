---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Go Clean Group">
  <main class="container">
    <section class="hero">
      <h1>Go Clean Group</h1>
      <p>Scaffold ready. The design will land here.</p>
    </section>
  </main>
</Layout>

<style>
  .hero {
    padding-block: var(--space-16);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: var(--space-4);
  }

  .hero p {
    color: var(--color-muted);
    font-size: 1.125rem;
  }
</style>
